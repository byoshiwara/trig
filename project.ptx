<?xml version="1.0" encoding="utf-8"?>
<!--
    This file provides the overall configuration for your PreTeXt
    project. To edit the content of your document, open `source/main.ptx`
    (default location).
-->
<project ptx-version="2" source="ptx">
  <targets>
    <target name="web" format="html" source="trig.xml" publication="publication.xml"/>
    <target name="print" format="pdf" source="trig.xml"/>
    <target name="print-latex" format="latex" source="trig.xml"/>
    <target name="runestone" format="html" source="trig.xml" output-dir="published/yoshiwaratrig" publication="runestone.xml" />
  </targets>
</project>

